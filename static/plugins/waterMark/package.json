{
	"id":"waterMark",
	"name":"{{LNG['waterMark.meta.name']}}",
	"title":"{{LNG['waterMark.meta.title']}}",
	"version":"1.0",
	"source":{
		"className":"font-icon ri-water-flash-line bg-blue-6"
	},
	"category":"company,file,safe",
	"description":"{{LNG['waterMark.meta.desc']}}",
	"keywords":"watermark",
	"auther":{
		"copyright":"kodcloud.",
		"homePage":"http://www.kodcloud.com"
	},
	"configItem":{
		"pluginAuth":{
			"type":"userSelect",
			"value":{"all":1},
			"display":"{{LNG['admin.plugin.auth']}}",
			"desc":"{{LNG['admin.plugin.authDesc']}}",
			"require":1
		},
		"enable":{
			"type":"switch",
			"display":"{{LNG['waterMark.meta.enable']}}",
			"desc":"{{LNG['waterMark.meta.enableDesc']}}",
			"value":"1"
		},
		"text":{
			"type":"text",
			"display":"{{LNG['waterMark.meta.text']}}",
			"desc":"{{LNG['waterMark.meta.textDesc']}}",
			"value":"{user} {date}"
		},
		"fontSize":{
			"type":"number",
			"display":"{{LNG['waterMark.meta.fontSize']}}",
			"desc":"",
			"value":18,
			"info":{"from":10,"to":48,"step":1}
		},
		"opacity":{
			"type":"number",
			"display":"{{LNG['waterMark.meta.opacity']}}",
			"desc":"{{LNG['waterMark.meta.opacityDesc']}}",
			"value":12,
			"info":{"from":2,"to":50,"step":1}
		},
		"rotate":{
			"type":"number",
			"display":"{{LNG['waterMark.meta.rotate']}}",
			"desc":"",
			"value":-22,
			"info":{"from":-90,"to":90,"step":1}
		},
		"gap":{
			"type":"number",
			"display":"{{LNG['waterMark.meta.gap']}}",
			"desc":"",
			"value":180,
			"info":{"from":100,"to":600,"step":10}
		},
		"color":{
			"type":"text",
			"display":"{{LNG['waterMark.meta.color']}}",
			"desc":"",
			"value":"#000000"
		}
	}
}
